# ===========================================
# APPCHULA - Environment Variables
# ===========================================

# -------------------------------------------
# Supabase Configuration
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=postgresql://postgres:wk9DBKwtL9JFoXUC@db.pdebpzqkuhafoggyclvb.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# -------------------------------------------
# Application Settings
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=APPCHULA

# -------------------------------------------
# Authentication
# -------------------------------------------
# Token expiration for invitations (in hours)
INVITATION_TOKEN_EXPIRY_HOURS=24

# Session timeout (in minutes)
SESSION_TIMEOUT_MINUTES=20

# -------------------------------------------
# Email (Resend)
# -------------------------------------------
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=noreply@appchula.com

# -------------------------------------------
# Security
# -------------------------------------------
# 2FA code expiration (in minutes)
TWO_FA_CODE_EXPIRY_MINUTES=10

# Device remember duration (in days)
DEVICE_REMEMBER_DAYS=30

# -------------------------------------------
# Business Rules
# -------------------------------------------
# Minimum capital to generate yields (USD)
MINIMUM_CAPITAL_FOR_YIELDS=50000

# Days before withdrawal window to submit request
WITHDRAWAL_ADVANCE_DAYS=10

# Minimum months before first withdrawal
MINIMUM_MONTHS_FOR_WITHDRAWAL=3

# -------------------------------------------
# KYC/KYB (Future - Sumsub)
# -------------------------------------------
# SUMSUB_APP_TOKEN=your-app-token
# SUMSUB_SECRET_KEY=your-secret-key
# SUMSUB_WEBHOOK_SECRET=your-webhook-secret
